{
  "id": "synthetic_minus_split_codon",
  "title": "Synthetic minus-strand 3-exon CDS with a codon split across exons",
  "source": "synthetic",
  "units": { "test:PROT2": "aa" },
  "mappings": [
    { "kind": "cds", "protein": "test:PROT2", "location": "test:CHR2:complement(join(11..17,31..40,51..60))", "codonStart": 1, "aaLength": 8 }
  ],
  "cases": [
    { "note": "split codon on the minus strand", "input": "test:PROT2:4", "expect": { "targets": ["test:CHR2:complement(join(39..40,51))"], "unmapped": null } },
    { "input": "test:PROT2:8", "expect": { "targets": ["test:CHR2:complement(14..16)"], "unmapped": null } },
    { "input": "test:CHR2:51", "direction": "inverse", "expect": { "targets": ["test:PROT2:4c1"], "unmapped": null } },
    { "input": "test:CHR2:35..55", "direction": "inverse", "expect": { "targets": ["test:PROT2:2c3..6c1"], "orientation": ["reverse"], "unmapped": "test:CHR2:41..50" } },
    { "input": "test:CHR2:complement(58..60)", "direction": "inverse", "expect": { "targets": ["test:PROT2:1"], "orientation": ["forward"], "unmapped": null } }
  ]
